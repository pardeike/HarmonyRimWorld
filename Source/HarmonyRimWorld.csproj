<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>$(ModFileName)</RootNamespace>
    <AssemblyName>$(ModFileName)</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>bin/$(Configuration)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>$(ModVersion)</Version>
    <AssemblyVersion>$(ModVersion)</AssemblyVersion>
    <FileVersion>$(ModVersion)</FileVersion>
    <InformationalVersion>$(ModInformationalVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Brrainz</Company>
    <Authors>Andreas Pardeike</Authors>
    <Product>$(ModName)</Product>
    <NuGetAudit>false</NuGetAudit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/Source</PathMap>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="$(HarmonyLibVersion)" GeneratePathProperty="true" PrivateAssets="all" />
    <ProjectReference Include="../Tools/AssemblyMetadata/AssemblyMetadata.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldAssemblyDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldAssemblyDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldAssemblyDir)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateBuildInputs" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ActiveRimWorldVersion)' != '1.7' or '$(TargetFramework)' != 'net10.0'" Text="This project builds only the .NET 10 / RimWorld 1.7 wrapper. The released legacy folders are frozen." />
    <Error Condition="!Exists('$(PkgLib_Harmony)/lib/$(TargetFramework)/0Harmony.dll')" Text="The selected Lib.Harmony package must contain a native net10.0 asset. Run scripts/fetch-harmony.py if the package is missing." />
    <Error Condition="!Exists('$(RimWorldAssemblyDir)/Assembly-CSharp.dll')" Text="Set RimWorldAssemblyDir to the installed game's assembly directory." />
    <Exec LogStandardErrorAsError="true" Command="python3 -I &quot;$(MSBuildProjectDirectory)/../scripts/mod-package.py&quot; --validate-legacy" />
    <Exec LogStandardErrorAsError="true" Condition="'$(Configuration)' == 'Release' and '$(RIMWORLD_MOD_DIR)' != ''" Command="python3 -I &quot;$(MSBuildProjectDirectory)/../scripts/mod-package.py&quot; --mods-dir &quot;$(RIMWORLD_MOD_DIR)&quot; --check" EnvironmentVariables="RIMWORLD_ASSEMBLY_DIR=$(RimWorldAssemblyDir)" />
  </Target>
  <Target Name="StageMod" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)/../$(ActiveRimWorldVersion)/Assemblies" />
    <Exec LogStandardErrorAsError="true" Command="python3 -I &quot;$(MSBuildProjectDirectory)/../scripts/stage-harmony.py&quot; --package-dir &quot;$(PkgLib_Harmony)&quot; --built-library &quot;$(TargetDir)0Harmony.dll&quot; --metadata-tool &quot;$(MSBuildProjectDirectory)/../Tools/AssemblyMetadata/bin/$(Configuration)/net10.0/AssemblyMetadata.dll&quot;" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/../$(ActiveRimWorldVersion)/Assemblies" />
    <XmlPoke XmlInputPath="$(MSBuildProjectDirectory)/../About/About.xml" Query="//ModMetaData/modVersion" Value="$(ModInformationalVersion)" />
    <XmlPoke XmlInputPath="$(MSBuildProjectDirectory)/../About/Manifest.xml" Query="//Manifest/version" Value="$(ModVersion)" />
  </Target>
  <Target Name="CopyToRimworld" AfterTargets="StageMod" Condition="'$(Configuration)' == 'Release' and '$(RIMWORLD_MOD_DIR)' != ''">
    <Exec LogStandardErrorAsError="true" Command="python3 -I &quot;$(MSBuildProjectDirectory)/../scripts/mod-package.py&quot; --mods-dir &quot;$(RIMWORLD_MOD_DIR)&quot;" EnvironmentVariables="RIMWORLD_ASSEMBLY_DIR=$(RimWorldAssemblyDir)" />
  </Target>
</Project>
