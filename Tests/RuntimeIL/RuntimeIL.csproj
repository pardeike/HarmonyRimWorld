<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <DefineConstants>HARMONY_RUNTIME_IL_EXPERIMENT</DefineConstants>
    <GameDirectory>/Users/ap/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorld.app/Contents/MacOS</GameDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Source/RuntimeILBody.cs" Link="RuntimeILBody.cs" />
    <Compile Include="../../Source/RuntimeILPatching.cs" Link="RuntimeILPatching.cs" />
    <Reference Include="$(GameDirectory)/System*.dll" Private="false" />
    <Reference Include="$(GameDirectory)/Waylith.Injection.dll" Private="false" />
    <Reference Include="0Harmony"><HintPath>$(HarmonyAssemblyPath)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
